# ==============================================
# FIRS E-Invoicing Configuration
# ==============================================
# Add these variables to your .env file

# FIRS API Configuration
FIRS_API_URL=https://einvoice.firs.gov.ng/api/v1
# For sandbox/testing: https://sandbox.einvoice.firs.gov.ng/api/v1

# FIRS API Credentials (obtain from FIRS)
FIRS_API_KEY=your_firs_api_key_here
FIRS_TAXPAYER_ID=your_taxpayer_id_here

# Environment (sandbox or production)
FIRS_ENVIRONMENT=sandbox

# Timeout for API requests (seconds)
FIRS_TIMEOUT=30

# Enable/Disable FIRS e-invoicing
FIRS_EINVOICING_ENABLED=true

# Auto-submit invoices to FIRS upon creation
FIRS_AUTO_SUBMIT=true

# Use batch submission for multiple invoices
FIRS_BATCH_SUBMIT=false

# Batch submission size
FIRS_BATCH_SIZE=50

# Standard VAT rate in Nigeria (percentage)
FIRS_VAT_RATE=7.5

# ==============================================
# Digital Signature Configuration (JAdES)
# ==============================================

# ECDSA Private Key for invoice signing
# Option 1: Inline (replace \n with actual newlines)
ECDSA_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIExample123456789ABCDEF
-----END EC PRIVATE KEY-----"

# Option 2: File path (alternative)
# Store the key at storage/app/ecdsa_private.pem
# Leave ECDSA_PRIVATE_KEY empty to use the file

# ==============================================
# Queue Configuration (Required for FIRS)
# ==============================================

# Queue driver (database, redis, sqs, etc.)
QUEUE_CONNECTION=database

# ==============================================
# Notes
# ==============================================
# 1. Generate ECDSA key pair:
#    openssl ecparam -genkey -name secp256r1 -out ecdsa_private.pem
#    openssl ec -in ecdsa_private.pem -pubout -out ecdsa_public.pem
#
# 2. Submit public key to FIRS for verification
#
# 3. Never commit these credentials to version control
#
# 4. For production, set FIRS_ENVIRONMENT=production
#    and update FIRS_API_URL to production endpoint
#
# 5. Ensure queue worker is running:
#    php artisan queue:work --tries=3
